  "title": "A1 Week 01 — Greetings + introduction + closing (interactive)",
  "items": [
    {
      "id": "a1w01-mcq-1",
      "type": "multipleChoice",
      "prompt": "Choose the best opening for a first email (work).",
      "options": ["Hey!!", "Hello Alex,", "Yo,"],
      "answerIndex": 1,
      "explanation": "“Hello + name,” is a safe professional opening."
    },
    {
      "id": "a1w01-mcq-2",
      "type": "multipleChoice",
      "prompt": "Choose the best closing for a neutral work email.",
      "options": ["Kisses,", "Kind regards,", "See ya,"],
      "answerIndex": 1,
      "explanation": "“Kind regards,” is polite and standard in work emails."
    },
    {
      "id": "a1w01-mcq-3",
      "type": "multipleChoice",
      "prompt": "Choose the best subject line (simple + clear).",
      "options": ["Hi", "Introduction", "Meeting meeting meeting!!!"],
      "answerIndex": 1,
      "explanation": "A1: keep the subject short and clear."
    },
    {
      "id": "a1w01-mcq-4",
      "type": "multipleChoice",
      "prompt": "Choose the correct sentence.",
      "options": ["My name are Jordan.", "My name is Jordan.", "My name am Jordan."],
      "answerIndex": 1,
      "explanation": "Use “is” with “My name”."
    },
    {
      "id": "a1w01-fill-1",
      "type": "fillBlanks",
      "instructions": "Complete the missing words (4 blanks).",
      "text": "Hello ____,\n\nMy name is ____.\nI am a ____.\n\nKind regards,\n____",
      "answers": ["Alex", "Jordan", "designer", "Jordan"],
      "explanation": "Greeting + name + role + closing."
    },
    {
      "id": "a1w01-fill-2",
      "type": "fillBlanks",
      "instructions": "Complete the missing words (3 blanks).",
      "text": "Hello ____,\n\nI am in the ____ team.\nI can help with ____.\n\nThanks,\nAlex",
      "answers": ["Jordan", "sales", "reports"],
      "explanation": "A1 pattern: team + simple help sentence."
    },
    {
      "id": "a1w01-reorder-1",
      "type": "reorder",
      "instructions": "Put the email lines in the correct order.",
      "items": [
        "Kind regards,",
        "Hello Alex,",
        "My name is Jordan.",
        "I am a designer."
      ],
      "correctOrder": [1, 2, 3, 0],
      "explanation": "Order: greeting → name → role → closing."
    },
    {
      "id": "a1w01-reorder-2",
      "type": "reorder",
      "instructions": "Put the reply lines in the correct order.",
      "items": [
        "Best regards,",
        "Hello Jordan,",
        "Nice to meet you.",
        "Thanks for your email."
      ],
      "correctOrder": [1, 3, 2, 0],
      "explanation": "A1 reply: greeting → thanks → nice to meet you → closing."
    },
    {
      "id": "a1w01-err-1",
      "type": "errorCorrection",
      "instructions": "Choose the correct sentence.",
      "pairs": [
        {
          "wrong": "My name are Jordan.",
          "correct": "My name is Jordan.",
          "explanation": "Use “is” with “My name”."
        },
        {
          "wrong": "I am in a designer.",
          "correct": "I am a designer.",
          "explanation": "Use “a/an” before a job."
        }
      ]
    },
    {
      "id": "a1w01-err-2",
      "type": "errorCorrection",
      "instructions": "Choose the correct sentence.",
      "pairs": [
        {
          "wrong": "I am in the sales.",
          "correct": "I am in sales.",
          "explanation": "Department names often work without “the” in this simple pattern."
        },
        {
          "wrong": "Kind regard,",
          "correct": "Kind regards,",
          "explanation": "Standard closing is “Kind regards,” (plural)."
        }
      ]
    }
